# ============================================================
# DACA Operations Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
APP_SECRET_KEY=              # Generate: python -c "import secrets; print(secrets.token_hex(32))"
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://daca_ops:password@localhost:5432/daca_ops

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Google APIs (service account for Drive, Sheets, Gmail) ---
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service_account.json
GMAIL_DELEGATED_USER=daca@rho.co

# --- Google Drive Folder/File IDs (production values) ---
DRIVE_CLIENT_FILES_FOLDER_ID=121c4-xohOHgK8J_-vX-I-Mfoc7nTR3mX
DRIVE_OPS_MANUAL_FOLDER_ID=1uB1PnEMnGhrrvDzO-jZXnwVYKBfr0I8C
DRIVE_WEBSTER_REPORTS_FOLDER_ID=1tlhEB2u3Xn-3chFJ-8l8eb4PS58-SbEP
DRIVE_DACA_TEMPLATE_FILE_ID=1yzdpW6V-jSC_R-CBl2wev7QlDXCUAWzI

# --- Google Sheets IDs (production values) ---
TYPEFORM_SHEET_ID=1Oog92OTZ5w4Lss-CSVJ-jos8d4Or3K8qu6EQe0EuvtE
TYPEFORM_SHEET_GID=1055296310
DACA_SUMMARY_SHEET_ID=140z-O_ZoRyY97w4W5hBYBsUylQPJysj8rVXbzRJzRls

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-                        # Bot User OAuth Token from api.slack.com
SLACK_DACA_OPS_CHANNEL_ID=C0APFKNF8SY       # #daca-ops (primary ops + email notifications)
SLACK_DACA_APPLICATIONS_CHANNEL=daca-applications
SLACK_DACA_TRANSACTIONS_CHANNEL=daca-transactions
SLACK_TM_CHANNEL=transactionmonitoring

# --- Jira ---
JIRA_BASE_URL=https://rho.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=                             # Email of the Jira API user
JIRA_PROJECT_KEY=CSHELP                      # primary board (DACA Request issuetype)
JIRA_EXTRA_PROJECTS=COMPLHELP                # comma-separated; each queried with text ~ "DACA"

# --- DocuSign (Phase 2 — leave blank until API access confirmed) ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_SENDER_EMAIL=contracts@docusign.rho.co
DOCUSIGN_BASE_URL=https://na4.docusign.net

# --- Salesforce (Phase 2 — leave blank until Connected App provisioned) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_PRIVATE_KEY_PATH=
SALESFORCE_USERNAME=
SALESFORCE_INSTANCE_URL=https://rho.my.salesforce.com

# --- Zendesk ---
ZENDESK_SUBDOMAIN=https://rho.zendesk.com
ZENDESK_EMAIL=                               # Email of the Zendesk API user
ZENDESK_API_TOKEN=

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Authentication ---
AUTH_MODE=NONE                               # NONE (default) | GOOGLE_SSO
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_ALLOWED_DOMAIN=rho.co            # Only @rho.co accounts allowed

# --- Webster Bank Reporting ---
WEBSTER_REPORT_RECIPIENTS=stoliveira@websterbank.com
WEBSTER_REPORT_CC=shani.abrahams@rho.co,mike.szarowicz@rho.co,jeff.pasquerella@rho.co

# --- Weekly Slack Update ---
WEEKLY_UPDATE_DAY=tuesday
WEEKLY_UPDATE_TIME_ET=10:00

# --- Scheduled Tasks ---
GMAIL_POLL_INTERVAL_SECONDS=60
TYPEFORM_POLL_INTERVAL_MINUTES=10
SLA_CHECK_INTERVAL_MINUTES=15
OPS_MANUAL_SYNC_DAY=monday                  # Day of week to sync ops manual from Drive
